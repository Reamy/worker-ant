# ANS Server
# 默认端口 27183 的**单一真源**在 packages/shared-types/src/ans-defaults.ts——
# 下列两项仅在需要**显式覆盖**默认时保留；值须与真源一致，勿各自手写（zx_20261005 M21）。
ANS_SERVER_PORT=27183
ANS_ENCRYPTION_KEY=  # 64位hex(32字节)，生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANS_API_KEYS=dev-key:dev-secret  # 格式: key1:secret1,key2:secret2

# 桌面端出站调用 ANS（桌面端 ↔ ANS 的凭据；缺省时 dev 用 dev-key/dev-secret，生产为「未配置」）
ANS_SERVER_URL=http://localhost:27183
ANS_API_KEY=dev-key
ANS_SECRET_KEY=dev-secret

# ── 遗留（归档前 Web 形态残留；勿据此臆断存在 :9410/:9411 服务）────────────────
# 下列变量仍被桌面端 main 内若干模块读取（auth-oauth.ts / core/auth.ts / ipc/auth.ipc.ts），
# 当前主路径不用；保留仅为兼容，OAuth 登录路径清理时一并移除。
WA_SERVER_PORT=9411    # 遗留 OAuth 回调端口（auth-oauth.ts 的 SERVER_URL）；非现行服务端口
WA_JWT_SECRET=         # 桌面端本地会话 JWT 密钥；留空则每次启动随机生成
# OAuth（可选；需自备 GitHub / Google OAuth App）
# AUTH_GITHUB_ID=  # GitHub OAuth App Client ID
# AUTH_GITHUB_SECRET=  # GitHub OAuth App Client Secret
# AUTH_GOOGLE_ID=  # Google OAuth Client ID
# AUTH_GOOGLE_SECRET=  # Google OAuth App Client Secret
