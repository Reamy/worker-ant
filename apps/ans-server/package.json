    "@worker-ant/ans-client": "workspace:*",
    "@worker-ant/shared-types": "workspace:*",
    "better-sqlite3": "11.10.0",
    "elysia": "^1.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
