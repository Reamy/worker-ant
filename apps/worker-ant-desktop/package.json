{
  "name": "@worker-ant/desktop",
  "version": "0.5.0",
  "description": "工蚁 Worker Ant — 跑在你机器上、用手机就能指挥的私有 AI 打工队",
  "homepage": "https://github.com/Reamy/worker-ant",
  "author": {
    "name": "Reamy",
    "email": "yangmujiang@sohu.com"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @worker-ant/desktop-renderer build && pnpm rebuild:native && tsup && bash ../../scripts/resign-native-macos.sh --probe && electron . --dev ; bash ../../scripts/rebuild-ans-native.sh",
    "dev:renderer": "pnpm --filter @worker-ant/desktop-renderer dev",
    "build": "tsup",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "rebuild:native": "electron-rebuild -f",
    "stage:ans": "node ../../scripts/stage-ans-runtime.mjs",
    "prepack": "pnpm rebuild:native",
    "pack": "pnpm stage:ans && electron-builder --dir",
    "dist": "pnpm stage:ans && pnpm rebuild:native && electron-builder",
    "dist:mac": "node ../../scripts/require-notarize-env.mjs && pnpm dist --mac",
    "dist:win": "node ../../scripts/build-desktop-target.mjs --platform=win32 --arch=x64",
    "dist:linux": "node ../../scripts/build-desktop-target.mjs --platform=linux --arch=x64",
    "dist:mac:unsigned": "node ../../scripts/build-desktop-target.mjs --platform=darwin --arch=arm64 --unsigned"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.2.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@worker-ant/ans-client": "workspace:*",
    "@worker-ant/shared-types": "workspace:*",
    "ai": "^4.2.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "11.10.0",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.3.0",
    "jose": "^5.9.0",
    "mqtt": "^5.16.0",
    "node-cron": "^4.5.0",
    "node-ssdp": "^4.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/node-ssdp": "^4.0.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
